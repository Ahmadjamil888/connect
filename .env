# AI Assistant Configuration
# Copy this file to .env and fill in your values

# Groq API Key (free, get at https://console.groq.com/keys)
# Leave empty to use Ollama (local mode)
GROQ_API_KEY=
# Option 2: OpenRouter (FREE tier, multiple models)
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3-70b-instruct

# Option 3: Google Gemini (FREE tier, 60 requests/min)
# Get key: https://makersuite.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-pro

# Option 4: Hugging Face (FREE, many models)
# Get key: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# Option 5: Ollama (LOCAL, unlimited, requires Ollama installed)
# Download: https://ollama.ai
OLLAMA_MODEL=llama3.2

# =============================================================================
# OTHER SETTINGS
# =============================================================================

# Debug Mode (true/false)
AI_ASSISTANT_DEBUG=false

# Email Settings (for send_email tool)
EMAIL_FROM=
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=
EMAIL_PASSWORD=
AI_PROVIDER=groq
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_bmVhdC1zcGFuaWVsLTExLmNsZXJrLmFjY291bnRzLmRldiQ
CLERK_SECRET_KEY=sk_test_pxBE42eERT3806XVSJgUVSdORB7TTn3NmpUxwP54nM
GROQ_MODEL=compound-beta
