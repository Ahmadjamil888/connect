# AI Assistant Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# AI MODEL OPTIONS
# Set AI_PROVIDER to force a provider, otherwise CONNECT auto-selects the first
# configured provider in this order: anthropic, groq, openai, openrouter,
# gemini, huggingface, ollama.
# =============================================================================

AI_PROVIDER=

# Option 1: Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-latest

# Option 2: Groq (FREE, Fast, 500+ requests/day)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=compound-beta
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Option 3: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Option 4: OpenRouter (FREE tier, multiple models)
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3-70b-instruct

# Option 5: Google Gemini (FREE tier, 60 requests/min)
# Get key: https://makersuite.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-2.5-flash

# Option 6: Hugging Face (FREE, many models)
# Get key: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# Option 7: Ollama (LOCAL, unlimited, requires Ollama installed)
# Download: https://ollama.ai
OLLAMA_MODEL=llama3.2

# =============================================================================
# OTHER SETTINGS
# =============================================================================

# Debug Mode (true/false)
AI_ASSISTANT_DEBUG=false

# Email Settings (for send_email tool)
EMAIL_FROM=
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=
EMAIL_PASSWORD=

# GitHub API token for PR tools (repo scope required; pull_requests:write for approve/merge)
GITHUB_TOKEN=

# Optional: secret used to sign audit log entries
AI_ASSISTANT_AUDIT_SECRET=
