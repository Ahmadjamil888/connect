# IMOS — Intelligent Machine Operating System
# Copy this file to .env and fill in your values.
# Run the setup wizard: imos --setup
# NEVER commit .env to git. It is in .gitignore.

# ── AI MODEL PROVIDER ────────────────────────────────────────────────────────
# IMOS auto-selects the first configured provider.
# Supported: anthropic, groq, openai, openrouter, gemini, huggingface,
#            ollama, azure, bedrock, nvidia, gcp
AI_PROVIDER=

# Anthropic (Claude) — best for tool use + vision
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Groq — free tier, very fast
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# OpenRouter — routes to any model
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Google Gemini
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-2.0-flash

# Hugging Face
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Ollama (local, no key needed — install from https://ollama.ai)
OLLAMA_MODEL=llama3

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_MODEL=gpt-4o

# AWS Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL=anthropic.claude-sonnet-4-5-20251101-v1:0

# NVIDIA NIM
NVIDIA_API_KEY=

# RunPod / custom OpenAI-compatible endpoint
RUNPOD_API_KEY=
RUNPOD_ENDPOINT=

# ── DEPLOYMENT ───────────────────────────────────────────────────────────────
VERCEL_TOKEN=
NETLIFY_TOKEN=

# ── VERSION CONTROL ──────────────────────────────────────────────────────────
# GitHub personal access token (repo + workflow scopes)
GITHUB_TOKEN=

# ── WEATHER ──────────────────────────────────────────────────────────────────
# open-meteo is free and needs no key — add others for more options
OPENWEATHER_API_KEY=
WEATHERAPI_KEY=
TOMORROW_API_KEY=

# ── NEWS ─────────────────────────────────────────────────────────────────────
# Google RSS and BBC RSS are free — add keys for more sources
NEWS_API_KEY=
GNEWS_API_KEY=
WORLDNEWS_API_KEY=
WORLDMONITOR_API_KEY=

# ── EMAIL ────────────────────────────────────────────────────────────────────
EMAIL_FROM=
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=587
EMAIL_PASSWORD=

# ── VOICE ────────────────────────────────────────────────────────────────────
# Picovoice wake word — optional, free tier at https://picovoice.ai
PICOVOICE_KEY=

# ── IMOS BEHAVIOUR ───────────────────────────────────────────────────────────
IMOS_WORKSPACE=
IMOS_SYSTEM_PROMPT_EXTRA=
IMOS_VOICE_ENABLED=true
IMOS_VOICE_RATE=175
IMOS_THEME=orange
AI_ASSISTANT_DEBUG=false
